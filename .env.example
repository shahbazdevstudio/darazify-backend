NODE_ENV=development
PORT=5000
# Comma separated list. The FIRST one is used to build password-reset links.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RAWG games API (kept server-side, never exposed to the browser)
GAMES_API_URL=https://api.rawg.io/api
GAMES_API_KEY=
GAMES_PLATFORMS=4
GAME_PRICE=250

# WhatsApp Cloud API (Meta). API URL = https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=923001234567
# Optional: approved template name (needed if the admin has not messaged your number in the last 24h)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# SMTP for password-reset emails (if empty in development, the reset link is printed in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Darazify <no-reply@darazify.com>"

# Used by `npm run seed:admin`
ADMIN_NAME=Darazify Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
